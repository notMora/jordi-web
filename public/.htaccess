# Hostinger (Apache/LiteSpeed). Upload together with the rest of public/ into public_html.

Options -Indexes
DirectoryIndex index.html

# Force HTTPS and the bare domain (www -> moradesign.shop)
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# One URL per page: /index.html and /de/…/index.html redirect to the folder URL
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
RewriteRule ^ /%1 [L,R=301]
# Section hubs without their own page go to the matching home section
RewriteRule ^services/?$ /#services [NE,L,R=301]
RewriteRule ^de/leistungen/?$ /de/#services [NE,L,R=301]
RewriteRule ^es/servicios/?$ /es/#services [NE,L,R=301]

ErrorDocument 404 /404.html

# Never serve hidden files (.env, .git, .DS_Store…) or backups/sources
RedirectMatch 404 /\.(?!well-known/)
<FilesMatch "\.(md|bak|old|orig|zip|tar|gz|sql|log|map|json|lock|psd|fig)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Only first-party code runs, plus Google Analytics after the visitor accepts (assets/js/consent.js).
  # Cal.com (availability + bookings) and Formspree (contact form) are the other external endpoints.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self'; font-src 'self'; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://api.cal.com https://formspree.io https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # Caching: fonts never change; CSS/JS/images revalidate weekly (file names are not hashed)
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpg|jpeg|png|svg|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>
